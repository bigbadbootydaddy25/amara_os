{
  "county": "Polk",
  "state": "FL",
  "fips": "12105",

  "gis": {
    "baseUrl": "https://maps.polk-county.net/arcgis/rest/services",
    "subdivisionLayer": "Property/PolkSubdivisions/MapServer/0",
    "parcelLayer": "Property/PolkParcels/MapServer/0",
    "zoningLayer": "Planning/ZoningMapService/MapServer/0",
    "permitLayer": "Development/BuildingPermits/MapServer/0"
  },

  "propertyAppraiser": {
    "baseUrl": "https://www.polkpa.org",
    "searchEndpoint": "/CamaDisplay/Requests/GetAppraisalRecord",
    "platSearchEndpoint": "/CamaDisplay/Requests/GetSubdivisionList"
  },

  "clerk": {
    "baseUrl": "https://www.polkclerk.com",
    "officialRecordsSearch": "/official-records/search"
  },

  "pipeline": {
    "rateLimitMs": 1200,
    "maxRetries": 3,
    "retryBackoffMs": 2000,
    "timeoutMs": 30000,
    "batchSize": 50,
    "outputDir": "./output",
    "logLevel": "info"
  },

  "platExpiration": {
    "preliminaryPlatMaxAgeMonths": 24,
    "warningWindowMonths": 3,
    "dormancyThresholdYears": 5,
    "lookbackYears": 10
  },

  "distress": {
    "minScore": 0,
    "maxRetries": 2,
    "courtListenerRateMs": 2000
  },

  "scoring": {
    "minCompositeScore": 70,
    "minSpreadNet": 300000,
    "qualifyingSpeeds": ["FAST", "MEDIUM"]
  },

  "openclaw": {
    "url": "http://127.0.0.1:18789",
    "channel": "telegram",
    "retryIntervalMs": 60000
  },

  "airtable": {
    "baseId": "app0jn857ZwVzQs8i",
    "table": "Land Pipeline"
  },

  "ollama": {
    "url": "http://127.0.0.1:11434",
    "model": "llama3"
  },

  "agents": {
    "01": { "id": "plat-expiration-scanner",    "enabled": true,  "module": "./agents/01-plat-expiration-scanner"    },
    "02": { "id": "distress-scanner",            "enabled": true,  "module": "./agents/02-distress-scanner"           },
    "03": { "id": "builder-demand-scanner",      "enabled": true,  "module": "./agents/03-builder-demand-scanner"     },
    "04": { "id": "opportunity-scorer",          "enabled": true,  "module": "./agents/04-opportunity-scorer"         },
    "05": { "id": "quick-flip-filter",           "enabled": true,  "module": "./agents/05-quick-flip-filter"          },
    "06": { "id": "builder-buybox-profiler",     "enabled": true,  "module": "./agents/06-builder-buybox-profiler"    }
  }
}
