# PostgreSQL connection string
# For local dev: postgresql://user:password@localhost:5432/propvision
# For AWS RDS: postgresql://user:password@<rds-endpoint>:5432/propvision
DATABASE_URL=postgresql://postgres:password@localhost:5432/propvision

# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# CORS — set to your frontend origin
CORS_ORIGIN=http://localhost:5173

# Amara AI provider: stub | openai | perplexity | claude
AMARA_AI_PROVIDER=stub

# AI provider keys (wire in when AMARA_AI_PROVIDER is set)
PERPLEXITY_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Pipeline cron schedule (default: 6am daily)
# Uses node-cron syntax: https://www.npmjs.com/package/node-cron
PIPELINE_CRON_SCHEDULE=0 6 * * *

# Set to "true" to disable cron in dev without touching the schedule
DISABLE_PIPELINE_CRON=false
