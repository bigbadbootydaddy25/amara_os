class TestLoadRecords:
    def test_fixture_exists(self):
        assert FIXTURES.exists(), f"Fixture missing: {FIXTURES}"

    def test_load_returns_records(self):
        records = load_records(FIXTURES)
        assert len(records) > 0

    def test_each_record_has_id(self):
        records = load_records(FIXTURES)
        for r in records:
            assert r.record_id or r.record_id == "", "record_id field must exist"


class TestRunPipeline:
    def test_produces_all_outputs(self):
        records = load_records(FIXTURES)
        with tempfile.TemporaryDirectory() as tmp:
            paths = run_pipeline(records, Path(tmp))
        assert len(paths) >= 1
        for name, path in paths.items():
            assert Path(path).exists(), f"Output file missing: {path}"

