    "@opentelemetry/sdk-node": "^0.218.0",
    "@qdrant/js-client-rest": "^1.9.0",
    "bullmq": "^5.7.0",
    "ioredis": "^5.3.2",
    "langchain": "^1.4.4",
    "mem0ai": "^3.0.6",
    "neo4j-driver": "^5.19.0",
    "pg": "^8.11.5",
    "uuid": "^9.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "@types/pg": "^8.11.5",
    "@types/uuid": "^9.0.8",
    "@vitest/coverage-v8": "^1.5.0",
