{
  "name": "aces-n8s-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:capital": "npm run dev -w apps/capital",
    "dev:land-development": "npm run dev -w apps/land-development",
    "dev:investment-holdings": "npm run dev -w apps/investment-holdings",
    "dev:title-land-intelligence": "npm run dev -w apps/title-land-intelligence",
    "dev:amara-os": "npm run dev -w apps/amara-os",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "typescript": "^5"
  }
}
