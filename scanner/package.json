{
  "name": "amara-os-scanner",
  "version": "2.0.0",
  "private": true,
  "description": "AMARA OS — Land Intelligence Pipeline (multi-county OSINT)",
  "main": "run-land-scanner.js",
  "scripts": {
    "scan":            "node run-land-scanner.js",
    "scan:dry":        "node run-land-scanner.js --dry-run",
    "intake":          "node run-land-scanner.js --agents 00",
    "install:browser": "npx playwright install chromium --with-deps"
  },
  "dependencies": {
    "axios":      "^1.7.9",
    "cheerio":    "^1.0.0",
    "playwright": "^1.49.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
