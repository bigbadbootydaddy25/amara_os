# ─── ElevenLabs TTS ───────────────────────────────────────────────────────────
# Charlotte (British) voice: XB0fDUnXU5powFXDhCwa
# Default voice: 4DH4Uqhp9kTcPJlssqc6
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=XB0fDUnXU5powFXDhCwa

# ─── AI Backends (priority: OpenClaw → OpenAI → Ollama) ───────────────────────
OPENCLAW_GATEWAY_URL=
OPENCLAW_GATEWAY_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ─── Ollama (offline / local LLM fallback) ────────────────────────────────────
# Set OLLAMA_BASE_URL to enable Ollama as final fallback
# Run: ollama serve && ollama pull llama3.2
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ─── Mac Automation ───────────────────────────────────────────────────────────
# Enables POST /api/mac AppleScript bridge (macOS only)
# Generate a random secret: openssl rand -hex 32
ENABLE_MAC_AUTOMATION=false
MAC_AUTOMATION_SECRET=

# ─── App Behaviour ────────────────────────────────────────────────────────────
NEXT_PUBLIC_DEMO_MODE=false
# Set true to bypass offline check when Ollama is configured
NEXT_PUBLIC_OLLAMA_ENABLED=false
