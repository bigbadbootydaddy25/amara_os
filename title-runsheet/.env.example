# --- Postgres --------------------------------------------------------------
DATABASE_URL=postgres://user:password@localhost:5432/title_runsheet

# --- Dropbox -----------------------------------------------------------------
# Scoped app token (Settings > App console > your app > Generate access token),
# or an OAuth2 refresh-token flow if you'd rather not rotate a long-lived token.
DROPBOX_ACCESS_TOKEN=
DROPBOX_REFRESH_TOKEN=
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=

# Root Dropbox folders this app watches/writes. Each project also stores its
# own paths in the `projects` table (seeded relative to these roots).
DROPBOX_SELLER_PACKAGE_ROOT=/Title Runsheet/Seller Packages
DROPBOX_RECORDED_INSTRUMENTS_ROOT=/Title Runsheet/Recorded Instruments
DROPBOX_RUNSHEET_EXPORT_ROOT=/Title Runsheet/Runsheets
DROPBOX_REPORT_EXPORT_ROOT=/Title Runsheet/Reports

# --- Instrument retrieval portal ---------------------------------------------
# "texasfile" ships a selector map in src/browser/portals/texasfile.ts; point
# PORTAL_NAME at a different key in src/browser/portals/index.ts (e.g. a county
# clerk site) to swap portals without touching agent code.
PORTAL_NAME=texasfile
PORTAL_BASE_URL=https://www.texasfile.com
PORTAL_USERNAME=
PORTAL_PASSWORD=
# Run the browser visibly for first-time selector verification against the
# live site; leave true for unattended/CI runs.
PORTAL_HEADLESS=true

# --- Default search tract (can be overridden per project in Postgres) -------
DEFAULT_STATE=TX
DEFAULT_COUNTY=Howard
DEFAULT_SURVEY_SECTION=47
DEFAULT_SURVEY_BLOCK=33
DEFAULT_SURVEY_TOWNSHIP=T1S
