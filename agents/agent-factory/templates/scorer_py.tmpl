"""
Confidence scoring engine for ${DISPLAY_NAME}.

Sums signal weights (deduplicated by signal_type, capped at 100).
Records below the threshold are excluded from top-ranked outputs.

Generated by Agent Factory | Workflow: ${WORKFLOW_ID}
"""
from __future__ import annotations

from typing import List

from models import ${MODEL_CLASS}
from signals import SIGNAL_WEIGHTS

_MAX_SCORE = 100


def compute_score(record: ${MODEL_CLASS}) -> int:
    """Sum canonical weights for signals attached to a record, capped at 100."""
    seen: set = set()
    total = 0
    for sig in record.signals:
        if sig.signal_type not in seen:
            total += SIGNAL_WEIGHTS.get(sig.signal_type, sig.weight)
            seen.add(sig.signal_type)
    return min(total, _MAX_SCORE)


def score_all(records: List[${MODEL_CLASS}]) -> List[${MODEL_CLASS}]:
    """Compute and attach confidence_score to every record in-place."""
    for record in records:
        record.confidence_score = compute_score(record)
    return records


def rank_results(
    records: List[${MODEL_CLASS}],
    threshold: int = ${MIN_THRESHOLD},
) -> List[${MODEL_CLASS}]:
    """Return records at or above threshold, sorted by score descending."""
    return sorted(
        [r for r in records if r.confidence_score >= threshold],
        key=lambda r: r.confidence_score,
        reverse=True,
    )
