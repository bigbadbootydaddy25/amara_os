#!/usr/bin/env python3
"""
${DISPLAY_NAME} -- main entry point.

${DESCRIPTION}

Generated by Agent Factory | Workflow: ${WORKFLOW_ID} | v${VERSION}

Usage:
${USAGE_LINES}
"""
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path
from typing import Any, Dict, List

sys.path.insert(0, str(Path(__file__).parent))

from models import ${MODEL_CLASS}
from scorer import rank_results, score_all
from signals import detect_all_signals
from reporter import generate_all_reports


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(description="${DESCRIPTION}")
${PARSER_ARGS}
    p.add_argument("--output-dir", "-o", default="reports",
                   help="Output directory (default: reports/).")
    p.add_argument("--verbose", "-v", action="store_true")
    return p


def load_records(path: Path, verbose: bool = False) -> List[${MODEL_CLASS}]:
    raw = json.loads(path.read_text(encoding="utf-8"))
    if not isinstance(raw, list):
        raise ValueError("Input must be a JSON array.")
    records: List[${MODEL_CLASS}] = []
    for item in raw:
        try:
            records.append(${MODEL_CLASS}.from_dict(item, source_file=str(path)))
        except Exception as exc:
            if verbose:
                print(f"  [WARN] Skipping malformed record: {exc}", file=sys.stderr)
    if verbose:
        print(f"  Loaded {len(records)} record(s) from {path}")
    return records


def run_pipeline(
    records: List[${MODEL_CLASS}],
    output_dir: Path,
    verbose: bool = False,
) -> Dict[str, Path]:
    _log = (lambda msg: print(f"  {msg}")) if verbose else (lambda _: None)

    _log(f"Detecting signals on {len(records)} record(s) ...")
    for record in records:
        record.signals = detect_all_signals(record)

    _log("Scoring records ...")
    scored = score_all(records)

    _log("Ranking results ...")
    ranked = rank_results(scored, threshold=${MIN_THRESHOLD})

    _log(f"Writing reports to {output_dir} ...")
    paths = generate_all_reports(ranked, records, output_dir)
    for name, path in paths.items():
        _log(f"  + {path.name}")
    return paths


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()

    input_path = Path(getattr(args, "${PRIMARY_INPUT_ATTR}"))
    if not input_path.exists():
        print(f"ERROR: Input file not found: {input_path}", file=sys.stderr)
        return 1

    output_dir = Path(args.output_dir)

    if args.verbose:
        print(f"\n${DISPLAY_NAME}")
        print(f"  input  : {input_path}")
        print(f"  output : {output_dir}")
        print()

    try:
        records = load_records(input_path, verbose=args.verbose)
    except (json.JSONDecodeError, ValueError) as exc:
        print(f"ERROR: {exc}", file=sys.stderr)
        return 1

    if not records:
        print("ERROR: No valid records found.", file=sys.stderr)
        return 1

    run_pipeline(records, output_dir, verbose=args.verbose)

    if args.verbose:
        print(f"\nDone. Reports written to {output_dir}/\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
