# Copy this file to .env and fill in real values.
# .env is git-ignored - never commit real keys.

# Direct Postgres connection string for the Supabase project.
# Supabase dashboard: Project Settings > Database > Connection string (URI).
# PostGIS is enabled on first call to /health/db (CREATE EXTENSION IF NOT EXISTS postgis).
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# Supabase project API credentials, used by later phases for supabase-py client calls.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=
